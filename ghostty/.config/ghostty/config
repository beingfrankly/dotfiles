# ===== Font Configuration =====
font-family = JetBrainsMono Nerd Font
font-size = 14
adjust-cell-height = 25%
font-thicken = false

# ===== Cursor =====
cursor-style = block
cursor-style-blink = false

# ===== Shell Integration =====
shell-integration-features = no-cursor,sudo,no-title

# ===== Appearance =====
background-opacity = 1.00
background-blur = false

# Circadia Warm Parchment
theme = circadia-light

# Custom shader for cursor effects
custom-shader = ~/.config/ghostty/shaders/cursor_warp.glsl
custom-shader-animation = true

# ===== macOS-specific =====
# Hides the titlebar entirely: no window title, no traffic-light buttons.
# Keeps the window frame and rounded corners (unlike window-decoration = none).
macos-titlebar-style = hidden
macos-option-as-alt = true

# ===== Window Configuration =====
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
window-save-state = always
window-colorspace = display-p3

# Disable dimming for inactive splits
unfocused-split-opacity = 1

# ===== Mouse Configuration =====
mouse-hide-while-typing = true
focus-follows-mouse = false
mouse-scroll-multiplier = 2
clipboard-read = allow
clipboard-write = allow
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = false

# ===== Performance =====
resize-overlay = never
resize-overlay-duration = 0

# ===== Keybindings =====
# Splits - disabled (herdr handles multiplexing)
# Includes Ghostty's own defaults, not just the previous custom binds,
# so cmd+[ / cmd+alt+arrows / cmd+ctrl+arrows no longer navigate splits.
keybind = cmd+d=unbind
keybind = cmd+shift+d=unbind
keybind = cmd+[=unbind
keybind = cmd+]=unbind
keybind = cmd+h=unbind
keybind = cmd+j=unbind
keybind = cmd+k=unbind
keybind = cmd+l=unbind
keybind = cmd+shift+h=unbind
keybind = cmd+shift+j=unbind
keybind = cmd+shift+k=unbind
keybind = cmd+shift+l=unbind
keybind = cmd+alt+up=unbind
keybind = cmd+alt+down=unbind
keybind = cmd+alt+left=unbind
keybind = cmd+alt+right=unbind
keybind = cmd+ctrl+up=unbind
keybind = cmd+ctrl+down=unbind
keybind = cmd+ctrl+left=unbind
keybind = cmd+ctrl+right=unbind
keybind = cmd+ctrl+==unbind
keybind = cmd+shift+enter=unbind

# Close the window (no splits or tabs left to close)
keybind = cmd+w=close_surface

# Tabs - disabled (use splits instead)
# Every default tab binding is unbound, including the physical digit_N
# variants, otherwise cmd+N still switches tabs.
keybind = cmd+t=unbind
keybind = cmd+shift+[=unbind
keybind = cmd+shift+]=unbind
keybind = ctrl+tab=unbind
keybind = ctrl+shift+tab=unbind
keybind = cmd+alt+w=unbind
keybind = cmd+1=unbind
keybind = cmd+2=unbind
keybind = cmd+3=unbind
keybind = cmd+4=unbind
keybind = cmd+5=unbind
keybind = cmd+6=unbind
keybind = cmd+7=unbind
keybind = cmd+8=unbind
keybind = cmd+9=unbind
keybind = cmd+digit_1=unbind
keybind = cmd+digit_2=unbind
keybind = cmd+digit_3=unbind
keybind = cmd+digit_4=unbind
keybind = cmd+digit_5=unbind
keybind = cmd+digit_6=unbind
keybind = cmd+digit_7=unbind
keybind = cmd+digit_8=unbind

# Windows
keybind = cmd+n=new_window

# Zoom/Focus
keybind = cmd+shift+z=unbind
keybind = cmd+ctrl+f=toggle_fullscreen

# Font size adjustment
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+0=reset_font_size

# Inspector
keybind = cmd+shift+i=inspector:toggle

# ===== Other Settings =====
copy-on-select = clipboard
confirm-close-surface = false
quit-after-last-window-closed = false
auto-update = download
keybind = shift+enter=text:\x1b\r
