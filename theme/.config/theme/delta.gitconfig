# luna theme for delta (git diff viewer)
# Palette from https://github.com/WTFox/luna.nvim (lua/luna/palette.lua)
# Include this in your ~/.gitconfig with:
# [include]
#     path = ~/.config/theme/delta.gitconfig

[delta]
    features = luna
    side-by-side = true
    line-numbers = true
    navigate = true

[delta "luna"]
    # Minus (deletions) - luna bg_delete / error
    minus-style                   = syntax "#40000a"
    minus-non-emph-style          = syntax "#40000a"
    minus-emph-style              = syntax "#70282f"
    minus-empty-line-marker-style = syntax "#40000a"
    line-numbers-minus-style      = "#e08585"

    # Plus (additions) - luna git.add / ok
    plus-style                    = syntax "#152017"
    plus-non-emph-style           = syntax "#152017"
    plus-emph-style               = syntax "#263d2b"
    plus-empty-line-marker-style  = syntax "#152017"
    line-numbers-plus-style       = "#6fbe80"

    # Line numbers - luna grey_warm
    line-numbers-zero-style       = "#605958"
    line-numbers-left-style       = "#605958"
    line-numbers-right-style      = "#605958"

    # General - luna signal / warning
    file-style = "#c2916a" bold
    file-decoration-style = "#c2916a" ul
    hunk-header-style = "#d9a35a" bold
    hunk-header-decoration-style = "#d9a35a" box

    # Commit - luna func
    commit-style = "#75a1c7" bold
    commit-decoration-style = "#75a1c7" box

    # Whitespace
    whitespace-error-style = "#e08585" reverse

    # Blame - luna surfaces, dark to light
    blame-palette = "#060606" "#1c1c1c" "#1f1f1f" "#333333"
    blame-code-style = syntax

    # Merge conflict
    merge-conflict-begin-symbol = "⮜"
    merge-conflict-end-symbol = "⮞"
    merge-conflict-ours-diff-header-style = "#d9a35a" bold
    merge-conflict-theirs-diff-header-style = "#d9a35a" bold

    # Inline hints - luna comment
    inline-hint-style = "#7c7c7c"

# luna color reference:
# Background: #060606      Surface: #1c1c1c / #1f1f1f / #333333
# Foreground: #e4e4e8      Comment: #7c7c7c    Grey warm: #605958
# error #e08585  warning #d9a35a  info #8c9cb8  hint #b09080  ok #6fbe80
# keyword #e19067  func #75a1c7  type #c4a8d6  string #9eb38e  signal #c2916a
