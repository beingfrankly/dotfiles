# circadia-light theme for delta (git diff viewer)
# Palette from https://github.com/tanmaymanojgandhi/circadia
# Include this in your ~/.gitconfig with:
# [include]
#     path = ~/.config/theme/delta.gitconfig

[delta]
    features = circadia-light
    light = true
    syntax-theme = circadia-light
    side-by-side = true
    line-numbers = true
    navigate = true

[delta "circadia-light"]
    # Minus (deletions) - circadia-light bg_delete / error
    minus-style                   = syntax "#f2ddd3"
    minus-non-emph-style          = syntax "#f2ddd3"
    minus-emph-style              = syntax "#e7bfb4"
    minus-empty-line-marker-style = syntax "#f2ddd3"
    line-numbers-minus-style      = "#a12622"

    # Plus (additions) - circadia-light git.add / ok
    plus-style                    = syntax "#e4ebd7"
    plus-non-emph-style           = syntax "#e4ebd7"
    plus-emph-style               = syntax "#cbdcb9"
    plus-empty-line-marker-style  = syntax "#e4ebd7"
    line-numbers-plus-style       = "#005f2f"

    # Line numbers - circadia-light grey_warm
    line-numbers-zero-style       = "#524b42"
    line-numbers-left-style       = "#524b42"
    line-numbers-right-style      = "#524b42"

    # General - circadia-light signal / warning
    file-style = "#843900" bold
    file-decoration-style = "#843900" ul
    hunk-header-style = "#095b62" bold
    hunk-header-decoration-style = "#095b62" box

    # Commit - circadia-light func
    commit-style = "#0048b3" bold
    commit-decoration-style = "#0048b3" box

    # Whitespace
    whitespace-error-style = "#a12622" reverse

    # Blame - circadia-light surfaces, dark to light
    blame-palette = "#f7f2e6" "#eee7d6" "#eee7d6" "#d7cdb7"
    blame-code-style = syntax

    # Merge conflict
    merge-conflict-begin-symbol = "⮜"
    merge-conflict-end-symbol = "⮞"
    merge-conflict-ours-diff-header-style = "#095b62" bold
    merge-conflict-theirs-diff-header-style = "#095b62" bold

    # Inline hints - circadia-light comment
    inline-hint-style = "#524b42"
