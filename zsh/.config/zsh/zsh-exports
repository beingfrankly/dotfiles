#!/usr/bin/env zsh
# Environment exports

# ===== Path Configuration =====
export PATH="$HOME/.rd/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.local/bin/lua-language-server/bin:$PATH"
export PATH="$HOME/.local/bin/jdtls/bin:$PATH"
# Homebrew — macOS: /opt/homebrew, Linux: /home/linuxbrew/.linuxbrew
if [[ -d /opt/homebrew ]]; then
  export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
elif [[ -d /home/linuxbrew/.linuxbrew ]]; then
  export PATH="/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin:$PATH"
fi
[[ -d "/Applications/Obsidian.app/Contents/MacOS" ]] && export PATH="/Applications/Obsidian.app/Contents/MacOS:$PATH"

# ===== Editor Configuration =====
export EDITOR='nvim'
export VISUAL='nvim'
export MANPAGER='nvim +Man!'
export MANWIDTH=999

# ===== Docker =====
[[ -d "$HOME/.rd/bin" ]] && export PATH="$HOME/.rd/bin:$PATH"

# ===== FZF Configuration (circadia-light) =====
# Palette from https://github.com/tanmaymanojgandhi/circadia
export FZF_DEFAULT_OPTS="\
--highlight-line \
--info=inline-right \
--ansi \
--layout=reverse \
--border=none \
--color=bg+:#eee7d6 \
--color=bg:#f7f2e6 \
--color=border:#d7cdb7 \
--color=fg:#28323a \
--color=fg+:#46535f \
--color=gutter:#f7f2e6 \
--color=header:#843900 \
--color=hl+:#843900 \
--color=hl:#843900 \
--color=info:#1c60a2 \
--color=marker:#524b42 \
--color=pointer:#46535f \
--color=prompt:#0048b3 \
--color=query:#28323a:regular \
--color=scrollbar:#d7cdb7 \
--color=separator:#843900 \
--color=spinner:#46535f \
--height=40% --preview-window=right:60%"

# ===== EZA Configuration =====
# circadia-light theme loaded from ~/.config/eza/theme.yml

# ===== Less Configuration =====
export LESS='-R -F -X -i'
export LESSHISTFILE=-

# ===== Language/Locale =====
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# ===== MCP Server Configuration =====
export PROJECTS_DIR="$HOME/code"
export NEOVIM_MCP="$HOME/.config/mcp-servers/neovim"
export OBSIDIAN_VAULT_PATH="$HOME/Sync/Obsidian/Second Brain"

export SONARLINT_NVIM="8da6072b6ae72c00ce520bb09115ab96822164ee"

# ===== OPENCODE =====
# export PATH=/Users/Frank.vanEldijk/.opencode/bin:$PATH

# Slack MCP (add your tokens to secrets-global.sh if needed)
# export SLACK_BOT_TOKEN=""
# export SLACK_TEAM_ID=""

# GitHub MCP (add your token to secrets-global.sh if needed)
# export GITHUB_PERSONAL_ACCESS_TOKEN=""

# Jam.dev MCP (add your API key to secrets-global.sh if needed)
# export JAM_API_KEY=""

# ===== Global secrets (needed outside the hfs repo) =====
# Repo-scoped HFS_* secrets now load via direnv from ~/code/hfs/.envrc
if [[ -f "$HOME/.config/zsh/secrets-global.sh" ]]; then
    source "$HOME/.config/zsh/secrets-global.sh"
fi

# ===== Atlas.nvim (Jira + Bitbucket) =====
# Tokens come from macOS Keychain (service: jira_api_token); see
# ~/.config/nvim/lua/kickstart/plugins/atlas.lua for the lookup helper.
export JIRA_URL="https://headfirst.atlassian.net"
export JIRA_EMAIL="frank.vaneldijk@headfirst.nl"
export BITBUCKET_USER="frank.vaneldijk@headfirst.nl"
